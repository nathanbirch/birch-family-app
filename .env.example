# ---------------------------------------------------------------------------
# Birch Family App — environment template
#
# Copy this file to `.env` and fill in the real values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. This template is committed
# on purpose (see the `!.env.example` exception in .gitignore) so that anyone
# picking the project up knows exactly which variables it needs.
#
# The same two variables must also be set in the Vercel project settings for
# the deployed app to work. See docs/deployment.md.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string.
#
# The app only ever writes to the `birch_family_app` database (see
# src/config/db.ts), so the database path on the end of the URI is not used and
# can be left off.
#
# Find it at https://cloud.mongodb.com → Cluster → Connect → Drivers.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.pmxixtt.mongodb.net/

# Signing key for the session cookie (HS256 JWT). At least 32 characters.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing this instantly signs everyone out on every device. Keep it identical
# across any environments that should share sessions.
SESSION_SECRET=
