# ---------------------------------------------------------------------------
# Birch Family App — environment template
#
# Copy this file to `.env` and fill in the real values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. This template is committed
# on purpose (see the `!.env.example` exception in .gitignore) so that anyone
# picking the project up knows exactly which variables it needs.
#
# The same two variables must also be set in the Vercel project settings for
# the deployed app to work. See docs/deployment.md.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string.
#
# The app only ever writes to the `birch_family_app` database (see
# src/config/db.ts), so the database path on the end of the URI is not used and
# can be left off.
#
# Find it at https://cloud.mongodb.com → Cluster → Connect → Drivers.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.pmxixtt.mongodb.net/

# Signing key for the session cookie (HS256 JWT). At least 32 characters.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing this instantly signs everyone out on every device. Keep it identical
# across any environments that should share sessions.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# The family Google Calendar. OPTIONAL — leave it blank and the Calendar page
# explains how to connect one instead of showing events.
#
# This is the "Secret address in iCal format", not a normal calendar link:
#
#   Google Calendar (on a computer)
#     → hover the family calendar in the left-hand list
#     → Options (⋮) → Settings and sharing
#     → Integrate calendar → Secret address in iCal format
#
# The calendar lives on nathantbirch@gmail.com, so copy it while signed in as
# that account. It should end in `/basic.ics`.
#
# TREAT THIS AS A PASSWORD. Anyone holding the URL can read the entire
# calendar with no sign-in. It is read only on the server and never sent to the
# browser. If it leaks, "Reset secret address" on that same settings page
# invalidates it immediately.
# ---------------------------------------------------------------------------
CALENDAR_ICS_URL=

# ---------------------------------------------------------------------------
# THE BIRCH FAMILY READ-ONLY API
#
# Everything below powers `/api/family/v1/*`, which the private Birch Family
# Custom GPT calls through a GPT Action. It is off unless the flag is exactly
# "true", so leaving these blank changes nothing about the app.
#
# ---------------------------------------------------------------------------
# NONE OF THIS COSTS ANYTHING, AND NONE OF IT COMES FROM OPENAI
# ---------------------------------------------------------------------------
# BIRCH_FAMILY_API_KEY is *this app's own* front-door lock. You generate it
# yourself with `npm run api:key` — it is 32 random bytes from `node:crypto`
# and it is bought from nobody. It is emphatically NOT an OpenAI API key, and
# this app never calls OpenAI at all. The traffic goes one way only:
#
#     ChatGPT  --- Authorization: Bearer <this key> --->  this app
#
# ChatGPT presents the key; this app checks it and answers. There is no OpenAI
# SDK in package.json, no api.openai.com anywhere in src/, and no model bill.
# The GPT itself runs on the family's existing ChatGPT subscription.
#
# (This block exists because the variable used to be called CHATGPT_API_KEY,
# which read like something you had to go and buy. It is not.)
#
# Full setup: docs/family-api/setup-custom-gpt-action.md
# Security:   docs/family-api/security.md
# ---------------------------------------------------------------------------

# The kill switch. The API answers 503 for every request unless this is the
# exact string "true" — an unset, misspelled or empty value keeps it closed.
BIRCH_FAMILY_API_ENABLED=false

# The panic switch, separate on purpose. Set it to "true" during an incident;
# it is checked before authentication, so even a valid key is refused.
# Turning the API back on afterwards is then a deliberate second act.
BIRCH_FAMILY_API_DENY_ALL=false

# The bearer token ChatGPT presents to *this* app. Yours, self-generated, free.
# At least 256 bits of entropy, and a credential shared with nothing else here.
#
# Generate one with:
#   npm run api:key
#
# NEVER commit it, never paste it into the OpenAPI document, never put it in
# anything with NEXT_PUBLIC_ in the name. Its only two homes are the Vercel
# environment and ChatGPT's Action authentication panel.
BIRCH_FAMILY_API_KEY=

# The incoming key during a rotation. Both are accepted while both are set, so
# a rotation has no downtime: publish the new key here, paste it into the
# Custom GPT, confirm the logs report "v-next", then promote it to
# BIRCH_FAMILY_API_KEY and clear this one. See docs/family-api/operations-runbook.md.
BIRCH_FAMILY_API_KEY_NEXT=

# ---------------------------------------------------------------------------
# Rate limits. All optional — the compiled defaults are shown, and an
# unparseable value falls back to them rather than removing the ceiling.
# Lowering any of these is a one-variable change with no deploy.
# ---------------------------------------------------------------------------
# BIRCH_FAMILY_API_AUTH_FAIL_PER_MINUTE=5        # invalid keys tolerated, per source
# BIRCH_FAMILY_API_AUTH_FAIL_BLOCK_SECONDS=900   # block after exhausting the above
# BIRCH_FAMILY_API_BURST_PER_MINUTE=10           # per credential
# BIRCH_FAMILY_API_SUSTAINED_PER_HOUR=60         # per credential
# BIRCH_FAMILY_API_DAILY_PER_CREDENTIAL=300      # per credential, per Boise day
# BIRCH_FAMILY_API_DAILY_GLOBAL=1000             # circuit breaker across all credentials
# BIRCH_FAMILY_API_CACHE_TTL_SECONDS=45          # how long a built response is reused
# BIRCH_FAMILY_API_REQUEST_TIMEOUT_MS=8000       # deadline on the whole request
