{
  "name": "birch-family-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-server.mjs",
    "db:check": "node --env-file=.env scripts/check-database.mjs",
    "db:seed": "tsx --env-file=.env scripts/seed-database.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "schedule:generate": "tsx scripts/generate-balanced-schedule.ts",
    "icons:generate": "node scripts/generate-icons.mjs",
    "cache:clear": "rm -rf .next/cache/images",
    "avatars:generate": "node scripts/optimise-avatars.mjs",
    "pets:generate": "node scripts/optimise-pets.mjs",
    "sound:generate": "node scripts/generate-cheer.mjs",
    "api:openapi": "tsx scripts/generate-openapi.ts",
    "api:key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\"",
    "api:probe": "node scripts/family-api-probe.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.5",
    "mongodb": "^7.5.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
